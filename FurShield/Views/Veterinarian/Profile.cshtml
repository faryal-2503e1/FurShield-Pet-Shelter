@model FurShield.Data.Veterinarian
@using Microsoft.AspNetCore.Identity
@using FurShield.Data
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Doctor Profile";
    Layout = "~/Views/Shared/_VetLayout.cshtml";

    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Navigation Tabs -->
            <ul class="nav nav-pills nav-justified mb-4 bg-white p-2 rounded-3 shadow-sm" id="profileTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold py-2" id="view-tab" data-bs-toggle="tab" data-bs-target="#view-profile" type="button" role="tab">
                        <i class="bi bi-person-badge me-2"></i>My Profile
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold py-2" id="edit-tab" data-bs-toggle="tab" data-bs-target="#edit-profile" type="button" role="tab">
                        <i class="bi bi-pencil-square me-2"></i>Edit Profile
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="profileTabsContent">

                <!-- TAB 1: READ-ONLY PROFILE VIEW -->
                <div class="tab-pane fade show active" id="view-profile" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-primary text-white p-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; font-size: 2rem;">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                                <div>
                                    <h4 class="mb-1 fw-bold">@(currentUser?.FullName ?? Model.User?.FullName ?? "Doctor")</h4>
                                    <span class="badge bg-light text-primary fw-semibold px-3 py-1">
                                        <i class="bi bi-patch-check-fill me-1"></i>@(string.IsNullOrEmpty(Model.Specialization) ? "Veterinarian" : Model.Specialization)
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label class="text-muted small fw-bold text-uppercase d-block mb-1">Email Address</label>
                                    <p class="fw-semibold text-dark mb-0"><i class="bi bi-envelope text-primary me-2"></i>@(currentUser?.Email ?? Model.User?.Email)</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-bold text-uppercase d-block mb-1">Phone Number</label>
                                    <p class="fw-semibold text-dark mb-0"><i class="bi bi-telephone text-primary me-2"></i>@(currentUser?.PhoneNumber ?? Model.User?.PhoneNumber ?? "Not Provided")</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-bold text-uppercase d-block mb-1">Experience</label>
                                    <p class="fw-semibold text-dark mb-0"><i class="bi bi-award text-primary me-2"></i>@(Model.Experience) Years</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-bold text-uppercase d-block mb-1">Clinic Address</label>
                                    <p class="fw-semibold text-dark mb-0"><i class="bi bi-geo-alt text-primary me-2"></i>@(string.IsNullOrEmpty(Model.Address) ? "Not Provided" : Model.Address)</p>
                                </div>
                                <div class="col-12">
                                    <label class="text-muted small fw-bold text-uppercase d-block mb-1">Professional Bio</label>
                                    <p class="text-secondary mb-0 bg-light p-3 rounded-3">
                                        @(string.IsNullOrEmpty(Model.Bio) ? "No bio added yet." : Model.Bio)
                                    </p>
                                </div>
                            </div>

                            <div class="mt-4 pt-3 border-top text-end">
                                <button type="button" class="btn btn-primary fw-bold px-4" onclick="document.getElementById('edit-tab').click();">
                                    <i class="bi bi-pencil-square me-1"></i> Edit Profile
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: EDIT PROFILE FORM -->
                <div class="tab-pane fade" id="edit-profile" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-sliders me-2"></i>Update Doctor Details</h5>
                        </div>
                        <div class="card-body p-4">
                            <form asp-action="Profile" method="post">

                                <!-- Personal Information -->
                                <div class="mb-4">
                                    <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2">Personal Information</h6>

                                    <div class="d-flex flex-column flex-md-row gap-3 mb-3">
                                        <div class="w-100">
                                            <label class="form-label fw-bold">Full Name</label>
                                            <input type="text" name="FullName" value="@(currentUser?.FullName ?? Model.User?.FullName)" class="form-control" required />
                                        </div>
                                        <div class="w-100">
                                            <label class="form-label fw-bold">Email Address</label>
                                            <input type="email" name="Email" value="@(currentUser?.Email ?? Model.User?.Email)" class="form-control" required />
                                        </div>
                                    </div>

                                    <div class="d-flex flex-column flex-md-row gap-3">
                                        <div class="w-50">
                                            <label class="form-label fw-bold">Phone Number</label>
                                            <input type="tel" name="PhoneNumber" value="@(currentUser?.PhoneNumber ?? Model.User?.PhoneNumber)" class="form-control" maxlength="11" minlength="11" pattern="\d{11}" oninput="this.value = this.value.replace(/[^0-9]/g, '');" required />
                                        </div>
                                    </div>
                                </div>

                                <!-- Professional Details -->
                                <div class="mb-4">
                                    <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2">Professional Details</h6>

                                    <div class="d-flex flex-column flex-md-row gap-3 mb-3">
                                        <div class="w-100">
                                            <label asp-for="Specialization" class="form-label fw-bold">Specialization</label>
                                            <input asp-for="Specialization" class="form-control" required />
                                        </div>
                                        <div class="w-100">
                                            <label asp-for="Experience" class="form-label fw-bold">Experience (Years)</label>
                                            <input asp-for="Experience" type="number" class="form-control" min="0" />
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Address" class="form-label fw-bold">Clinic / Practice Address</label>
                                        <input asp-for="Address" class="form-control" />
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Bio" class="form-label fw-bold">Professional Bio / Overview</label>
                                        <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                                    </div>
                                </div>

                                <!-- Buttons Section -->
                                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                    <button type="button" class="btn btn-outline-secondary px-4" onclick="document.getElementById('view-tab').click();">Cancel</button>
                                    <button type="submit" class="btn btn-success fw-bold px-4"><i class="bi bi-check-lg me-1"></i> Save Changes</button>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>