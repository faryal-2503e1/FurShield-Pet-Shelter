@model IEnumerable<FurShield.Data.VetTimeSlot>
@{
    ViewData["Title"] = "My Availability";
    Layout = "~/Views/Shared/_VetLayout.cshtml";
}

<div class="container py-4">
    <h3 class="fw-bold text-primary mb-4"><i class="bi bi-clock me-2"></i>My Available Time Slots</h3>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h6 class="fw-bold mb-3">Add a Weekly Slot</h6>
            <form asp-action="AddTimeSlot" method="post" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Day of Week</label>
                    <select name="dayOfWeek" class="form-select" required>
                        @foreach (var day in Enum.GetValues(typeof(DayOfWeek)))
                        {
                            <option value="@day">@day</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Start Time</label>
                    <input type="time" name="startTime" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">End Time</label>
                    <input type="time" name="endTime" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle"></i> Add Slot
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h6 class="fw-bold mb-0">Current Weekly Availability</h6>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Day</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slot in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@slot.DayOfWeek</td>
                                <td>@DateTime.Today.Add(slot.StartTime).ToString("hh:mm tt")</td>
                                <td>@DateTime.Today.Add(slot.EndTime).ToString("hh:mm tt")</td>
                                <td class="text-end pe-3">
                                    <form asp-action="DeleteTimeSlot" method="post" onsubmit="return confirm('Remove this slot?');" class="d-inline">
                                        <input type="hidden" name="id" value="@slot.VetTimeSlotId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-calendar-x display-5 text-secondary d-block mb-2"></i>
                    No availability set yet. Add your weekly slots above so pet owners know when you're free.
                </div>
            }
        </div>
    </div>
</div>
