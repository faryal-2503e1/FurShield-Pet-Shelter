@model IEnumerable<FurShield.Data.HealthRecord>

@{
    ViewData["Title"] = "Health Records";
    Layout = "~/Views/Shared/_PetOwnerLayout.cshtml";
    bool isInFamily = (bool)(ViewBag.IsInFamily ?? false);
    string currentUserId = ViewBag.CurrentUserId ?? "";
}

<style>
    .health-timeline { position: relative; margin-left: 1rem; padding-left: 1.5rem; border-left: 3px solid #dee2e6; }
    .health-timeline-item { position: relative; margin-bottom: 1.75rem; }
    .health-timeline-item::before {
        content: ""; position: absolute; left: -1.94rem; top: 0.2rem;
        width: 14px; height: 14px; border-radius: 50%; background: #000; border: 3px solid #fff; box-shadow: 0 0 0 2px #000;
    }
    .health-timeline-date { font-weight: bold; color: #000 !important; }
    .health-timeline-item a.small { color: #000 !important; }
    .health-timeline-item a.small:hover { color: #000 !important; text-decoration: underline; }
    #healthViewTabs .nav-link { color: #000 !important; }
    #healthViewTabs .nav-link:hover { color: #000 !important; }
    #healthViewTabs .nav-link.active { color: #fff !important; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-file-earmark-medical text-dark me-2"></i>
            @(isInFamily ? "Family Health Records" : "Health Records")
        </h2>
        <p class="text-muted small mb-0">
            @if (isInFamily)
            {
                <text>Diagnoses, treatments, and medical history for every pet in your family</text>
            }
            else
            {
                <text>View diagnoses, treatments, and medical history of your pets</text>
            }
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-journal-plus me-1"></i> Add Health Record
    </a>
</div>

<ul class="nav nav-pills mb-3" id="healthViewTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#timelineView" type="button">
            <i class="bi bi-clock-history"></i> Timeline View
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tableView" type="button">
            <i class="bi bi-table"></i> Table View
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- Visual Timeline -->
    <div class="tab-pane fade show active" id="timelineView">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="health-timeline">
                        @foreach (var item in Model)
                        {
                            <div class="health-timeline-item">
                                <div class="health-timeline-date">@item.VisitDate.ToString("dd MMM yyyy")</div>
                                <div>
                                    <span class="badge bg-info text-dark">@(item.Pet != null ? item.Pet.Name : "N/A")</span>
                                    <span class="text-muted small">with Dr. @(item.Veterinarian?.User?.UserName ?? "Doctor")</span>
                                    @if (isInFamily && item.Pet?.OwnerId != currentUserId)
                                    {
                                        <span class="badge bg-light text-dark border ms-1"><i class="bi bi-people-fill text-dark"></i> @(item.Pet?.Owner?.FullName ?? item.Pet?.Owner?.UserName)'s pet</span>
                                    }
                                </div>
                                <div class="mt-1">
                                    <strong>Diagnosis:</strong> @(string.IsNullOrEmpty(item.Diagnosis) ? "—" : item.Diagnosis)
                                    @if (!string.IsNullOrEmpty(item.Vaccination))
                                    {
                                        <span class="badge bg-success ms-2"><i class="bi bi-shield-check"></i> @item.Vaccination</span>
                                    }
                                    @if (item.AddedByOwner)
                                    {
                                        <span class="badge bg-secondary ms-2">Self-logged</span>
                                    }
                                </div>
                                <a asp-action="Details" asp-route-id="@item.HealthRecordId" class="small">View full record &raquo;</a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-journal-x display-5 text-secondary d-block mb-2"></i>
                        No health records found for your pets.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Table View -->
    <div class="tab-pane fade" id="tableView">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3">Visit Date</th>
                                <th>Pet Name</th>
                                @if (isInFamily)
                                {
                                    <th>Pet Owner</th>
                                }
                                <th>Veterinarian</th>
                                <th>Diagnosis</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold">@item.VisitDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-info text-dark">@(item.Pet != null ? item.Pet.Name : "N/A")</span></td>
                                        @if (isInFamily)
                                        {
                                            <td>
                                                @if (item.Pet?.OwnerId == currentUserId)
                                                {
                                                    <span class="badge bg-primary">You</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">@(item.Pet?.Owner?.FullName ?? item.Pet?.Owner?.UserName)</span>
                                                }
                                            </td>
                                        }
                                        <td>@(item.Veterinarian != null ? $"Dr. {item.Veterinarian.User?.UserName}" : "Self-logged")</td>
                                        <td>@item.Diagnosis</td>
                                        <td class="text-end pe-3">
                                            <a asp-action="Details" asp-route-id="@item.HealthRecordId" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> View Record
                                            </a>
                                            @if (item.AddedByOwner && item.Pet?.OwnerId == currentUserId)
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.HealthRecordId" class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-5">
                                        <i class="bi bi-journal-x display-5 text-secondary d-block mb-2"></i>
                                        No health records found for your pets.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>