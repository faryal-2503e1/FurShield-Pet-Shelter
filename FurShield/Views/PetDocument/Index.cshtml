@model IEnumerable<FurShield.Data.PetDocument>

@{
    ViewData["Title"] = "Uploaded Documents";
    Layout = "~/Views/Shared/_PetOwnerLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-folder2-open text-info me-2"></i>Document Vault</h2>
        <p class="text-muted small mb-0">Upload and access medical certificates, lab reports, and prescriptions</p>
    </div>
    <a asp-action="Upload" asp-route-petId="@ViewBag.PetId" class="btn btn-primary fw-semibold shadow-sm">
        <i class="bi bi-cloud-upload me-1"></i> Upload Document
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Document Title</th>
                        <th>Type</th>
                        <th>Pet Name</th>
                        <th>Upload Date</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold"><i class="bi bi-file-earmark-pdf text-danger me-2"></i>@item.Title</td>
                                <td>
                                    @if (item.DocumentType == "Insurance")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-shield-check me-1"></i>Insurance</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.DocumentType</span>
                                    }
                                </td>
                                <td><span class="badge bg-info text-dark">@(item.Pet != null ? item.Pet.Name : "N/A")</span></td>
                                <td>@item.UploadedDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                        <!-- View / Download Button -->
                                        <a href="@item.FilePath" target="_blank" class="btn btn-sm btn-outline-success text-nowrap d-inline-flex align-items-center shadow-none">
                                            <i class="bi bi-download me-1"></i> View / Download
                                        </a>

                                        <!-- Delete Button Form -->
                                        <form asp-action="Delete" asp-route-id="@item.DocumentId" method="post" class="d-inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this document?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap d-inline-flex align-items-center shadow-none">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-file-earmark-x display-5 text-secondary d-block mb-2"></i>
                                No medical documents uploaded yet. Click <strong>"Upload Document"</strong> to add one.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>