@model IEnumerable<FurShield.Data.Product>

@{
    ViewData["Title"] = "Pet Shop & Supplies | FurShield";
    if (User.IsInRole("PetOwner"))
    {
        Layout = "~/Views/Shared/_PetOwnerLayout.cshtml";
    }
}

<!-- Dark Hero Card -->
<section class="py-4 py-md-5">
    <div class="container">
        <div class="dark-hero-card d-flex flex-column flex-lg-row align-items-center justify-content-between">
            <div>
                <div class="breadcrumb" style="color:rgba(255,255,255,0.7);font-size:14px;margin-bottom:12px;">
                    <a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,0.7);text-decoration:none;">Home</a> / Pet Shop
                </div>
                <div class="eyebrow" style="color:#ff85a2;letter-spacing:1.5px;font-size:13px;font-weight:700;margin-bottom:16px;">CURATED ESSENTIALS</div>
                <h1 style="color:#fff;font-size:clamp(36px,5vw,56px);font-weight:700;line-height:1.15;margin-bottom:18px;">
                    Premium Nutrition,<br><span style="color:#ff85a2">Toys &amp; Healthcare.</span>
                </h1>
                <p style="color:rgba(255,255,255,0.85);font-size:1.05rem;max-width:520px;margin-bottom:0;">
                    Veterinarian-approved diets, interactive enrichment toys, grooming kits, and daily health supplements delivered directly to your doorstep.
                </p>
            </div>
            <div class="dark-hero-img-wrap mt-4 mt-lg-0" style="position:relative;width:240px;height:240px;border-radius:50%;overflow:hidden;border:4px solid rgba(255,255,255,0.2);box-shadow:0 12px 30px rgba(0,0,0,0.3);flex-shrink:0;">
                <img src="https://images.unsplash.com/photo-1583512603805-3cc6b41f3edb?auto=format&fit=crop&w=600&q=85"
                     alt="Pet essentials and toys" style="width:100%;height:100%;object-fit:cover;" />
            </div>
        </div>
    </div>
</section>

<!-- Shop Search & Filter Bar -->
<section class="section">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1" style="font-family:'Baloo 2',sans-serif;">Browse Catalog</h2>
                <p class="text-muted small mb-0">Discover high-quality food, treats, toys, and care supplies</p>
            </div>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline">
                <i class="fa-solid fa-bag-shopping me-2 text-danger"></i> View My Cart
            </a>
        </div>

        <form method="get" class="card border-0 shadow-sm rounded-4 p-3 mb-5" style="background:#fff;">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" name="searchString" value="@Context.Request.Query["searchString"]"
                               class="form-control border-start-0" placeholder="Search products by title or keyword..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="category" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var cat in ViewBag.Categories as List<string> ?? new List<string>())
                        {
                            <option value="@cat" selected="@(Context.Request.Query["category"] == cat)">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="sort" class="form-select" onchange="this.form.submit()">
                        <option value="newest" selected="@(string.IsNullOrEmpty((string)ViewBag.CurrentSort) || ViewBag.CurrentSort == "newest")">Newest</option>
                        <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc")">Price: Low to High</option>
                        <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc")">Price: High to Low</option>
                        <option value="name" selected="@(ViewBag.CurrentSort == "name")">Name: A-Z</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-filter me-1"></i> Filter
                    </button>
                </div>
            </div>
        </form>

        <!-- Products Grid -->
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white" style="transition: transform .3s ease, box-shadow .3s ease;">
                            <div style="height: 240px; overflow:hidden; position:relative; background:#f5f3ec;">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1589924691995-400dc9ecc119?auto=format&fit=crop&w=600&q=80" : item.ImageUrl)"
                                     class="w-100 h-100" style="object-fit: cover; transition: transform .5s ease;" alt="@item.Name" />
                                <span class="badge position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill bg-white text-dark shadow-sm small fw-bold">
                                    @item.Category
                                </span>
                            </div>
                            <div class="card-body p-4 d-flex flex-column">
                                <h4 class="fw-bold mb-1" style="font-family:'Baloo 2',sans-serif;font-size:20px;">@item.Name</h4>
                                <p class="text-muted small flex-grow-1 mb-3">
                                    @(item.Description != null && item.Description.Length > 90 ? item.Description.Substring(0, 90) + "..." : item.Description)
                                </p>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="fs-4 fw-bold text-success">Rs. @item.Price</div>
                                    <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-outline btn-sm">
                                        <i class="fa-solid fa-eye me-1"></i> Details
                                    </a>
                                </div>
                                <div class="d-flex gap-2">
                                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                                    {
                                        <form asp-controller="Cart" asp-action="Add" method="post" class="flex-grow-1">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="btn btn-outline-success w-100">
                                                <i class="fa-solid fa-cart-plus me-1"></i> Add to Cart
                                            </button>
                                        </form>
                                        <a asp-controller="Order" asp-action="Checkout" asp-route-productId="@item.ProductId"
                                           class="btn btn-primary px-3">
                                            Buy Now
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-area="Identity" asp-page="/Account/Login"
                                           asp-route-returnUrl="@Url.Action("Details", "Product", new { id = item.ProductId })"
                                           class="btn btn-outline-success w-100">
                                            <i class="fa-solid fa-cart-plus me-1"></i> Add to Cart
                                        </a>
                                        <a asp-area="Identity" asp-page="/Account/Login"
                                           asp-route-returnUrl="@Url.Action("Details", "Product", new { id = item.ProductId })"
                                           class="btn btn-primary px-3">
                                            Buy Now
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <div class="p-5 bg-white rounded-4 shadow-sm d-inline-block">
                        <i class="fa-solid fa-box-open fs-1 text-muted mb-2"></i>
                        <h4 class="fw-bold mt-2">No products found</h4>
                        <p class="text-muted mb-0">Try changing your search keywords or category filters.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>