@model FurShield.Data.Product

@{
    ViewData["Title"] = Model.Name + " - Pet Shop";
    if (User.IsInRole("PetOwner"))
    {
        Layout = "~/Views/Shared/_PetOwnerLayout.cshtml";
    }
}

<section class="section">
    <div class="container">
        <!-- Back Link -->
        <div class="mb-4">
            <a asp-action="Index" class="btn btn-outline btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Pet Shop
            </a>
        </div>

        <div class="row g-5 align-items-start">
            <!-- Product Image / Gallery -->
            <div class="col-lg-6">
                <div class="gallery-main rounded-4 overflow-hidden shadow-sm" style="background:#f5f3ec; position:relative;">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1589924691995-400dc9ecc119?auto=format&fit=crop&w=800&q=85" : Model.ImageUrl)"
                         class="w-100" style="height: 460px; object-fit: cover;"
                         alt="@Model.Name" />
                </div>
            </div>

            <!-- Product Summary & Actions -->
            <div class="col-lg-6">
                <div class="info-card">
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-bold mb-3">
                        <i class="fa-solid fa-tag text-danger me-1"></i> @Model.Category
                    </span>

                    <h1 class="fw-bold mb-2" style="font-family:'Baloo 2',sans-serif;font-size:36px;">@Model.Name</h1>

                    <div class="d-flex align-items-baseline gap-3 mb-3">
                        <span class="fs-2 fw-bold text-success">Rs. @Model.Price</span>
                        <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill small fw-bold">
                            <i class="fa-solid fa-check me-1"></i> In Stock &middot; Ready to Ship
                        </span>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-muted text-uppercase small mb-2">Description</h6>
                        <p class="text-muted" style="line-height:1.7;">@Model.Description</p>
                    </div>

                    <hr class="my-4" />

                    <!-- Cart and Checkout Actions -->
                    <div class="d-flex flex-column flex-sm-row gap-3">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post" class="flex-grow-1">
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <div class="d-flex gap-2">
                                    <input type="number" name="quantity" value="1" min="1" max="99"
                                           class="form-control text-center fw-bold" style="width:75px;" />
                                    <button type="submit" class="btn btn-outline-success flex-grow-1 py-3">
                                        <i class="fa-solid fa-cart-plus me-2"></i> Add to Cart
                                    </button>
                                </div>
                            </form>
                            <a asp-controller="Order" asp-action="Checkout" asp-route-productId="@Model.ProductId"
                               class="btn btn-primary py-3 px-4">
                                <i class="fa-solid fa-bag-shopping me-2"></i> Buy Now
                            </a>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login"
                               asp-route-returnUrl="@Url.Action("Details", "Product", new { id = Model.ProductId })"
                               class="btn btn-outline-success flex-grow-1 py-3">
                                <i class="fa-solid fa-cart-plus me-2"></i> Add to Cart
                            </a>
                            <a asp-area="Identity" asp-page="/Account/Login"
                               asp-route-returnUrl="@Url.Action("Details", "Product", new { id = Model.ProductId })"
                               class="btn btn-primary py-3 px-4">
                                <i class="fa-solid fa-bag-shopping me-2"></i> Buy Now
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (ViewBag.RatingWidget != null)
        {
            <div class="mt-5 card border-0 shadow-sm rounded-4 p-4 bg-white">
                @await Html.PartialAsync("_RatingWidget", (FurShield.Models.RatingWidgetViewModel)ViewBag.RatingWidget)
            </div>
        }
    </div>
</section>