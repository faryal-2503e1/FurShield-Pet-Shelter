@model IEnumerable<FurShield.Data.AdoptionListing>

@{
    ViewData["Title"] = "Pet Health Records";
    Layout = "~/Views/Shared/_ShelterLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0"><i class="bi bi-heart-pulse text-success me-2"></i>Pet Health Records</h3>
            <p class="text-muted mb-0">Maintain a dated history of vaccination, medical conditions, and care status for shelter pets.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Pet Name</th>
                            <th>Species / Breed</th>
                            <th>Current Health & Care Notes</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No pets available in shelter listings.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                var logs = item.CareLogs.OrderByDescending(l => l.CreatedAt).ToList();
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/45" : item.ImageUrl)"
                                                 class="rounded-circle me-3" style="width: 45px; height: 45px; object-fit: cover;" />
                                            <div>
                                                <strong class="d-block">@item.PetName</strong>
                                                <small class="text-muted">Status: @item.Status</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.Species @(string.IsNullOrEmpty(item.Breed) ? "" : $"({item.Breed})")</td>
                                    <td>
                                        <span class="badge bg-info text-dark text-wrap text-start p-2 fw-normal" style="max-width: 300px;">
                                            @(string.IsNullOrEmpty(item.HealthStatus) ? "No health record added yet." : item.HealthStatus)
                                        </span>
                                        @if (logs.Any())
                                        {
                                            <div class="small text-muted mt-1">
                                                Last updated @logs.First().CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                                &middot;
                                                <a href="#" data-bs-toggle="modal" data-bs-target="#historyModal-@item.AdoptionListingId">
                                                    View history (@logs.Count)
                                                </a>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#editHealthModal-@item.AdoptionListingId">
                                            <i class="bi bi-pencil-square me-1"></i> Update Health
                                        </button>

                                        <!-- Update Health Modal: adds a NEW dated log entry -->
                                        <div class="modal fade text-start" id="editHealthModal-@item.AdoptionListingId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-success text-white">
                                                        <h5 class="modal-title fw-bold"><i class="bi bi-heart-pulse me-2"></i>Update @item.PetName's Health Record</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form asp-action="UpdateStatus" method="post">
                                                        <div class="modal-body">
                                                            <input type="hidden" name="listingId" value="@item.AdoptionListingId" />
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">New Care / Health Note</label>
                                                                <textarea name="healthStatus" class="form-control" rows="4" placeholder="Enter today's health details, vaccinations, medical history..." required></textarea>
                                                                <div class="form-text">This is added as a new dated entry — past entries stay in the history below and are never overwritten.</div>
                                                            </div>
                                                            @if (logs.Any())
                                                            {
                                                                <hr />
                                                                <h6 class="fw-bold small text-muted">PREVIOUS ENTRIES</h6>
                                                                <div style="max-height: 220px; overflow-y: auto;">
                                                                    @foreach (var log in logs)
                                                                    {
                                                                        <div class="border-start border-3 border-success ps-2 mb-2">
                                                                            <div class="small fw-bold text-success">@log.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
                                                                            <div class="small">@log.Note</div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-success fw-bold">Save New Entry</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Full History Modal (read-only) -->
                                        <div class="modal fade text-start" id="historyModal-@item.AdoptionListingId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-light">
                                                        <h5 class="modal-title fw-bold"><i class="bi bi-clock-history me-2"></i>@item.PetName's Care History</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        @if (!logs.Any())
                                                        {
                                                            <p class="text-muted mb-0">No history recorded yet.</p>
                                                        }
                                                        else
                                                        {
                                                            <div class="health-timeline ms-2 ps-3" style="border-left: 3px solid #dee2e6;">
                                                                @foreach (var log in logs)
                                                                {
                                                                    <div class="mb-3">
                                                                        <div class="fw-bold text-success small">@log.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
                                                                        <div>@log.Note</div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
