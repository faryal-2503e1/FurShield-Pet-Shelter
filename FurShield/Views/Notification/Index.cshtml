@model IEnumerable<FurShield.Data.AppNotification>
@{
    ViewData["Title"] = "Notifications";
    if (User.IsInRole("Shelter"))
    {
        Layout = "~/Views/Shared/_ShelterLayout.cshtml";
    }
    else if (User.IsInRole("Veterinarian") || User.IsInRole("Vet"))
    {
        Layout = "~/Views/Shared/_VetLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_PetOwnerLayout.cshtml";
    }
}

<h2 class="fw-bold mb-4"><i class="bi bi-bell text-primary me-2"></i>Notifications</h2>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <ul class="list-group list-group-flush">
                @foreach (var n in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center @(n.IsRead ? "" : "bg-light")">
                        <div>
                            <span>@n.Message</span>
                            <div class="small text-muted">@n.DateCreated.ToString("dd MMM yyyy, hh:mm tt")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(n.Link))
                        {
                            <a href="@n.Link" class="btn btn-sm btn-outline-primary">View</a>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-bell-slash display-5 text-secondary d-block mb-2"></i>
                No notifications yet.
            </div>
        }
    </div>
</div>
