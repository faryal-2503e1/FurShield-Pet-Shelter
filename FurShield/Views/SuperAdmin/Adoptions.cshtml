@model IEnumerable<FurShield.Data.AdoptionListing>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Adoption Listings";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-heart-pulse text-danger me-2"></i> Adoption Listings</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Listing ID</th>
                        <th>Pet Name</th>
                        <th>Breed</th>
                        <th>Shelter Name</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No adoption listings found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var listing in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@listing.AdoptionListingId</td>
                                <td class="fw-bold text-dark">@listing.PetName</td>
                                <td><span class="badge bg-secondary">@listing.Breed</span></td>
                                <td>@(listing.Shelter != null ? listing.Shelter.ShelterName : "N/A")</td>
                                <td class="text-end pe-4">
                                    <form asp-action="DeleteAdoptionListing" asp-route-id="@listing.AdoptionListingId" method="post" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="bi bi-trash me-1"></i> Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>