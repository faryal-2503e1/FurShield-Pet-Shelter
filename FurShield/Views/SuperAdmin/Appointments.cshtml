@model IEnumerable<FurShield.Data.Appointment>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "All Appointments";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-calendar-check me-2"></i> System Appointments</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Appointment ID</th>
                        <th>Status</th>
                        <th>Veterinarian</th>
                        <th class="pe-4">Actions / Info</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                No appointments booked yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@item.AppointmentId</td>
                                <td><span class="badge bg-info text-dark">@item.Status</span></td>
                                <td>
                                    @if (item.Veterinarian != null && item.Veterinarian.User != null)
                                    {
                                        @(!string.IsNullOrEmpty(item.Veterinarian.User.FullName) ? item.Veterinarian.User.FullName : item.Veterinarian.User.UserName)
                                    }
                                    else
                                    {
                                        <span>N/A</span>
                                    }
                                </td>
                                <td class="pe-4 text-muted small">
                                    Appointment Recorded
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>