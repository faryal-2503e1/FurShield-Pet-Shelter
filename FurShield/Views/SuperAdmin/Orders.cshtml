@model IEnumerable<FurShield.Data.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "All Orders";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-bag-check me-2"></i> System Orders</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Order ID</th>
                    <th>Order Date</th>
                    <th>Total Amount</th>
                    <th>Items Count</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr><td colspan="4" class="text-center py-3 text-muted">No orders placed yet.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#@item.OrderId</td>
                            <td>@item.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-success fw-bold">Rs. @item.TotalAmount</td>
                            <td>@item.OrderItems.Count</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>