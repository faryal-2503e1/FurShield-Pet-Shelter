@model IEnumerable<FurShield.Data.AdoptionListing>

@{
    ViewData["Title"] = "Adopt a Pet";
    Layout = "~/Views/Shared/_PetOwnerLayout.cshtml"; // Is se sidebar andar hi rahega
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary"><i class="bi bi-heart-fill text-danger me-2"></i>Adopt a Pet</h2>
            <p class="text-muted mb-0">Browse available pets for adoption from trusted shelters.</p>
        </div>
    </div>

    <!-- Search/Filter Bar -->
    <form method="get" class="row g-3 mb-4">
        <div class="col-md-6">
            <input type="text" name="searchString" class="form-control" placeholder="Search by name or breed..." value="@Context.Request.Query["searchString"]" />
        </div>
        <div class="col-md-4">
            <select name="species" class="form-select">
                <option value="">All Species</option>
                <option value="Dog">🐶 Dog</option>
                <option value="Cat">🐱 Cat</option>
                <option value="Rabbit">🐰 Rabbit</option>
                <option value="Bird">🐦 Bird</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Filter</button>
        </div>
    </form>

    <!-- Pets Grid -->
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4">
            <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
            No pets available for adoption right now.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var pet in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        <img src="@pet.ImageUrl"
                             class="card-img-top"
                             alt="@pet.PetName"
                             style="height: 200px; width: 100%; object-fit: cover;"
                             onerror="this.onerror=null; this.src='https://via.placeholder.com/300x200?text=No+Image';" />
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark">@pet.PetName</h5>
                            <p class="card-text text-muted mb-1"><strong>Species:</strong> @pet.Species (@pet.Breed)</p>
                            <p class="card-text text-muted mb-1"><strong>Age:</strong> @pet.Age years | <strong>Gender:</strong> @pet.Gender</p>
                            <p class="card-text text-muted mb-2"><strong>Shelter:</strong> @pet.Shelter?.ShelterName</p>
                            <span class="badge bg-success">@pet.HealthStatus</span>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3">
                            <a asp-controller="Adopt" asp-action="Details" asp-route-id="@pet.AdoptionListingId" class="btn btn-primary">
                                Express Interest / Apply
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>