@model FurShield.Data.Product
@{
    Layout = "_ShelterLayout";
    ViewData["Title"] = "Edit Product";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <h4 class="fw-bold text-dark mb-4"><i class="bi bi-pencil-square me-2"></i> Update Product</h4>
                
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="ProductId" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Category" class="form-label fw-semibold"></label>
                            <select asp-for="Category" class="form-select">
                                <option value="Food">Food & Nutrition</option>
                                <option value="Toys">Toys & Entertainment</option>
                                <option value="Grooming">Grooming & Hygiene</option>
                                <option value="Accessories">Accessories & Leashes</option>
                                <option value="Healthcare">Healthcare & Supplements</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label fw-semibold"></label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StockQuantity" class="form-label fw-semibold">Stock Quantity</label>
                            <input asp-for="StockQuantity" type="number" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Replace Image (Optional)</label>
                            <input type="file" name="ProductImage" class="form-control" accept="image/*" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-bold px-4">Update Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
