@model IEnumerable<FurShield.Data.Order>

@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_PetOwnerLayout.cshtml";
    bool isInFamily = (bool)(ViewBag.IsInFamily ?? false);
    string currentUserId = ViewBag.CurrentUserId ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-bag-check text-primary me-2"></i>
            @(isInFamily ? "Family Orders" : "My Orders")
        </h2>
        <p class="text-muted small mb-0">
            @if (isInFamily)
            {
                <text>Orders placed by you and every member of your family group</text>
            }
            else
            {
                <text>Track and view history of your product purchases</text>
            }
        </p>
    </div>
    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary fw-bold">
        <i class="bi bi-shop me-1"></i> Continue Shopping
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Order #</th>
                        <th>Order Date</th>
                        @if (isInFamily)
                        {
                            <th>Ordered By</th>
                        }
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            bool isMine = item.OwnerId == currentUserId;
                            <tr class="@(isMine ? "" : "table-light")">
                                <td class="ps-3 fw-bold">#ORD-@item.OrderId</td>
                                <td>@item.OrderDate.ToString("dd MMM yyyy - hh:mm tt")</td>
                                @if (isInFamily)
                                {
                                    <td>
                                        @if (isMine)
                                        {
                                            <span class="badge bg-primary"><i class="bi bi-person-fill"></i> You</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="bi bi-people-fill text-primary"></i> @(item.Owner?.FullName ?? item.Owner?.UserName ?? "Family member")</span>
                                        }
                                    </td>
                                }
                                <td class="fw-bold text-success">Rs. @item.TotalAmount</td>
                                <td>
                                    <span class="badge @(item.Status == "Delivered" ? "bg-success" : item.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark")">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i> View Order
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(isInFamily ? 6 : 5)" class="text-center text-muted py-5">
                                <i class="bi bi-cart-x display-5 text-secondary d-block mb-2"></i>
                                No orders placed yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
