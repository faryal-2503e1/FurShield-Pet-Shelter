@model FurShield.Data.Product

@{
    ViewData["Title"] = "Checkout & Order Confirmation";
    if (User.IsInRole("PetOwner"))
    {
        Layout = "~/Views/Shared/_PetOwnerLayout.cshtml";
    }
}

<div class="container py-3">
    <div class="mb-4">
        <h2 class="fw-bold mb-1" style="font-family:'Baloo 2',sans-serif;"><i class="fa-solid fa-credit-card text-danger me-2"></i>Checkout</h2>
        <p class="text-muted small mb-0">Confirm your delivery details to complete your order</p>
    </div>

    <div class="row g-4 align-items-start">
        <!-- Left: Delivery & Payment Details Form -->
        <div class="col-lg-7">
            <div class="info-card form-card">
                <div class="eyebrow">Shipping Information</div>
                <h3 class="fw-bold mb-4">Delivery Details</h3>

                <form asp-action="PlaceOrder" method="post">
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="quantity" value="@ViewBag.Quantity" />

                    <div class="form-grid">
                        <div class="field full">
                            <label class="fw-bold small">Payment Method</label>
                            <select class="form-select py-3">
                                <option selected>Cash on Delivery (COD)</option>
                                <option>Online Bank Transfer</option>
                                <option>Debit / Credit Card</option>
                            </select>
                        </div>

                        <div class="field full">
                            <label class="fw-bold small">Delivery Instructions / Notes (Optional)</label>
                            <input type="text" class="form-control py-3" placeholder="e.g. Leave with gatekeeper or call on arrival" />
                        </div>

                        <div class="field full mt-3">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                                <a asp-controller="Product" asp-action="Index" class="btn btn-outline w-100 w-sm-auto">
                                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Shop
                                </a>
                                <button type="submit" class="btn btn-primary btn-lg w-100 w-sm-auto px-4 py-3 shadow-sm">
                                    <i class="fa-solid fa-shield-check me-2"></i> Confirm &amp; Place Order
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Right: Order Summary Card -->
        <div class="col-lg-5">
            <div class="info-card">
                <div class="eyebrow">Items in Order</div>
                <h3 class="fw-bold mb-3">Order Summary</h3>

                <div class="d-flex align-items-center p-3 rounded-4 mb-3" style="background:var(--fs-cream);">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1589924691995-400dc9ecc119?auto=format&fit=crop&w=400&q=80" : Model.ImageUrl)"
                         alt="@Model.Name" style="width: 75px; height: 75px; object-fit: cover;" class="rounded-3 me-3" />
                    <div>
                        <h6 class="fw-bold mb-1" style="font-family:'Baloo 2',sans-serif;font-size:17px;">@Model.Name</h6>
                        <small class="text-muted d-block">Rs. @Model.Price &times; @ViewBag.Quantity unit(s)</small>
                        <span class="badge bg-success-subtle text-success small mt-1">In Stock</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal</span>
                    <span class="fw-bold">Rs. @ViewBag.TotalPrice</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Shipping Charges</span>
                    <span class="text-success fw-bold">FREE</span>
                </div>

                <hr class="my-3" />

                <div class="d-flex justify-content-between align-items-baseline mb-2">
                    <span class="fw-bold fs-5">Total Amount</span>
                    <span class="fs-3 fw-bold text-success">Rs. @ViewBag.TotalPrice</span>
                </div>
                <small class="text-muted d-block text-center mt-2">
                    <i class="fa-solid fa-lock me-1 text-success"></i> 100% Safe &amp; Secure Order Processing
                </small>
            </div>
        </div>
    </div>
</div>