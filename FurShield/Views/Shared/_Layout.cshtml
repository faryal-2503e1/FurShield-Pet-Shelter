@using Microsoft.AspNetCore.Identity
@using FurShield.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FurShield | International Pet Care & Wellness</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,500&display=swap" rel="stylesheet">

    <!-- CSS Libs -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <!-- FurShield Elite Theme CSS -->
    <link rel="stylesheet" href="~/css/furshield/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/furshield/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/furshield/elite.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/furshield/furshield-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/furshield/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/furshield/bootstrap-compat-fix.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="elite-home">
    <!-- Top Announcement Bar -->
    <div class="topbar">
        <span>International Pet Care • Karachi · Dubai · London · Toronto <b><a asp-controller="Appointment" asp-action="Create" style="color:var(--fs-pink);text-decoration:none;">Book a consultation &rarr;</a></b></span>
    </div>

    <!-- Main Navigation Header -->
    <header class="header elite-header">
        <div class="container">
            <nav class="nav">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="fa-solid fa-paw"></i></span>
                    <span class="brand-text">FurShield<small>Better Care. Happier Pets.</small></span>
                </a>

                <div class="nav-links" id="mainNavLinks">
                    <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-area="" asp-controller="Product" asp-action="Index">Pet Shop</a>
                    <a asp-area="" asp-controller="Adopt" asp-action="Index">Adoption</a>
                    <a asp-area="" asp-controller="Home" asp-action="Vets">Find Vets</a>
                    <a asp-area="" asp-controller="Home" asp-action="About">About</a>
                    <a asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                </div>

                <div class="nav-actions">
                    <a class="icon-btn" asp-area="" asp-controller="Product" asp-action="Index" aria-label="Search Shop" title="Search Products">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </a>
                    <a class="icon-btn cart-link" asp-area="" asp-controller="Cart" asp-action="Index" aria-label="Shopping Cart" title="Cart">
                        <i class="fa-solid fa-bag-shopping"></i>
                        <span class="cart-dot" style="display:inline-flex;">!</span>
                    </a>
                    
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <!-- Authenticated User Portal Quick Actions -->
                        @if (User.IsInRole("PetOwner"))
                        {
                            <a class="btn btn-primary btn-sm d-none d-md-inline-flex" asp-area="" asp-controller="PetOwner" asp-action="Index">
                                <i class="fa-solid fa-gauge-high"></i> Dashboard
                            </a>
                        }
                        else if (User.IsInRole("Vet") || User.IsInRole("Veterinarian"))
                        {
                            <a class="btn btn-primary btn-sm d-none d-md-inline-flex" asp-area="" asp-controller="Veterinarian" asp-action="Index">
                                <i class="fa-solid fa-user-doctor"></i> Vet Portal
                            </a>
                        }
                        else if (User.IsInRole("Shelter"))
                        {
                            <a class="btn btn-primary btn-sm d-none d-md-inline-flex" asp-area="" asp-controller="Shelter" asp-action="Index">
                                <i class="fa-solid fa-house-chimney-heart"></i> Shelter Portal
                            </a>
                        }
                        else if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <a class="btn btn-primary btn-sm d-none d-md-inline-flex" asp-area="" asp-controller="SuperAdmin" asp-action="Index">
                                <i class="fa-solid fa-shield-halved"></i> Admin
                            </a>
                        }

                        <form class="d-inline ms-1" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button type="submit" class="btn btn-outline btn-sm text-danger border-0" title="Logout">
                                <i class="fa-solid fa-right-from-bracket"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline btn-sm d-none d-lg-inline-flex" asp-area="Identity" asp-page="/Account/Login">
                            Login
                        </a>
                        <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">
                            Book Visit
                        </a>
                    }

                    <!-- Mobile Menu Button -->
                    <button class="icon-btn menu-btn" type="button" id="mobileMenuBtn" aria-label="Toggle menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </nav>
        </div>
    </header>

    <!-- Main Body Render -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Global CTA Banner -->
    <div class="fs-footer-cta">
        <div class="fs-corner-blob pink tl" style="opacity:.5"></div>
        <div class="fs-deco fs-paw large" style="top:20%;right:8%"></div>
        <div class="fs-deco fs-bone" style="bottom:15%;right:22%"></div>
        <div class="container text-center py-4">
            <h2 class="display-6 fw-bold mb-3">Every Paw Deserves a Shield of Love.</h2>
            <p class="text-muted mb-4 mx-auto" style="max-width:560px;">
                Centralized health records, veterinary bookings, loving shelter adoptions, and premium pet supplies &mdash; all together in one calm, caring place.
            </p>
            <a class="btn btn-primary btn-lg px-4" asp-controller="Appointment" asp-action="Create">
                Book a Visit <i class="fa-solid fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>

    <!-- Rich 4-Column Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <a class="brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark"><i class="fa-solid fa-paw"></i></span>
                        <span class="brand-text" style="color:#fff">FurShield<small>Better Care. Happier Pets.</small></span>
                    </a>
                    <p style="margin-top:18px">
                        Professional grooming, wellness, certified veterinary care, shelter adoption and everyday pet essentials.
                    </p>
                    <div class="socials">
                        <a class="icon-btn" href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a class="icon-btn" href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a class="icon-btn" href="#" aria-label="Twitter"><i class="fa-brands fa-x-twitter"></i></a>
                    </div>
                </div>
                <div>
                    <h3>Quick Links</h3>
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Home" asp-action="About">About Us</a>
                    <a asp-controller="Product" asp-action="Index">Pet Shop</a>
                    <a asp-controller="Adopt" asp-action="Index">Adoption Listings</a>
                    <a asp-controller="Home" asp-action="Vets">Find Vets</a>
                    <a asp-controller="Home" asp-action="Contact">Contact Us</a>
                </div>
                <div>
                    <h3>Our Services</h3>
                    <a asp-controller="Home" asp-action="Index">Daycare & Play</a>
                    <a asp-controller="Home" asp-action="Index">Pet Grooming</a>
                    <a asp-controller="Home" asp-action="Vets">Veterinary Health</a>
                    <a asp-controller="Adopt" asp-action="Index">Shelter Network</a>
                    <a asp-controller="Product" asp-action="Index">Curated Pet Supplies</a>
                </div>
                <div>
                    <h3>Contact Us</h3>
                    <a href="#"><i class="fa-solid fa-location-dot me-2 text-danger"></i> Clifton, Block 4, Karachi</a>
                    <a href="#"><i class="fa-solid fa-phone me-2 text-danger"></i> +92 300 1234567</a>
                    <a href="#"><i class="fa-solid fa-envelope me-2 text-danger"></i> hello@furshield.com</a>
                    <a asp-controller="Home" asp-action="Contact" class="fw-bold mt-2 d-inline-block text-white">Send a Message &rarr;</a>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year FurShield. All Rights Reserved.</span>
                <span>
                    <a asp-controller="Home" asp-action="About">About</a> &middot;
                    <a asp-controller="Home" asp-action="Contact">Contact</a> &middot;
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                </span>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/furshield/main.js" asp-append-version="true"></script>
    <script src="~/js/furshield/animations.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Mobile navigation toggle handler
        document.getElementById('mobileMenuBtn')?.addEventListener('click', function () {
            var links = document.getElementById('mainNavLinks');
            if (links) {
                links.classList.toggle('open');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>