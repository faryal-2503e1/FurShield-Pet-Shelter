@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FurShield.Data
@inject UserManager<ApplicationUser> UserManager
@inject PetShelterContext DbContext

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FurShield Veterinarian Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/furshield/furshield-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/furshield/bootstrap-compat-fix.css" asp-append-version="true" />
    <!-- FurShield brand theme for the Veterinarian portal only -->
    <link rel="stylesheet" href="~/css/furshield/vet-dashboard-theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light">
    <div class="dashboard-shell">
        <!-- Sidebar -->
        <aside class="dashboard-sidebar sidebar--vet" id="vetSidebar">
            <div class="sidebar-brand">
                <a asp-controller="Veterinarian" asp-action="Index">
                    <i class="bi bi-hospital-fill"></i> Vet Portal
                </a>
            </div>

            <div class="sidebar-back">
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-arrow-left-circle"></i> Back to Main Website
                </a>
            </div>

            @{
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                Func<string, string, string> navActive = (ctrl, action) =>
                    (string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) &&
                     string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

                var vetUserId = UserManager.GetUserId(User);
                var unreadCount = vetUserId != null
                    ? await DbContext.Notifications.CountAsync(n => n.UserId == vetUserId && !n.IsRead)
                    : 0;
            }
            <nav class="sidebar-nav">
                <a class="sidebar-link @navActive("Veterinarian", "Index")" asp-controller="Veterinarian" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="sidebar-link @navActive("Veterinarian", "PetHistory")" asp-controller="Veterinarian" asp-action="PetHistory">
                    <i class="bi bi-file-earmark-medical"></i> Health Records
                </a>
                <a class="sidebar-link @navActive("Veterinarian", "Availability")" asp-controller="Veterinarian" asp-action="Availability">
                    <i class="bi bi-clock-history"></i> My Availability
                </a>
                <a class="sidebar-link @navActive("Notification", "Index")" asp-controller="Notification" asp-action="Index">
                    <i class="bi bi-bell-fill"></i> Notifications
                    @if (unreadCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill ms-auto px-2 py-1">@unreadCount</span>
                    }
                </a>
                <a class="sidebar-link @navActive("Veterinarian", "Profile")" asp-controller="Veterinarian" asp-action="Profile">
                    <i class="bi bi-person-lines-fill"></i> Profile
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <span class="sidebar-user-avatar"><i class="bi bi-person-badge"></i></span>
                    @{
                        var currentUser = await UserManager.GetUserAsync(User);
                        var displayName = currentUser?.FullName ?? UserManager.GetUserName(User);
                    }

                    <span class="sidebar-user-name">Dr.@displayName</span>
                </div>
                <form class="sidebar-logout-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")">
                    <button type="submit">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </aside>

        <div class="sidebar-backdrop" id="vetSidebarBackdrop"></div>

        <!-- Main content -->
        <div class="dashboard-content">
            <div class="dashboard-topbar">
                <button class="sidebar-toggle-btn" type="button" id="vetSidebarToggle" aria-label="Toggle menu">
                    <i class="bi bi-list"></i>
                </button>
                <span class="fw-bold text-primary"><i class="bi bi-hospital-fill me-1"></i> Vet Portal</span>
                <span></span>
            </div>

            <main role="main" class="dashboard-main">
                @{
                    var topbarUser = await UserManager.GetUserAsync(User);
                    var topbarName = topbarUser?.FullName ?? UserManager.GetUserName(User);
                }
                <div class="vet-welcome">
                    <div>
                        <h2>Welcome back, Dr. @topbarName</h2>
                        <p>@ViewData["Title"]</p>
                    </div>
                    <span class="vet-date-pill"><i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
                </div>
                @RenderBody()
            </main>

            <footer class="dashboard-footer">
                &copy; 2026 - <strong>FurShield (Veterinarian Panel)</strong>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var sidebar = document.getElementById('vetSidebar');
            var backdrop = document.getElementById('vetSidebarBackdrop');
            var toggleBtn = document.getElementById('vetSidebarToggle');

            function closeSidebar() {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
            }

            toggleBtn?.addEventListener('click', function () {
                sidebar.classList.toggle('show');
                backdrop.classList.toggle('show');
            });
            backdrop?.addEventListener('click', closeSidebar);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
