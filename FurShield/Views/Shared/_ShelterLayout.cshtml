@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FurShield.Data
@inject UserManager<ApplicationUser> UserManager
@inject PetShelterContext DbContext

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FurShield Shelter Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/furshield/furshield-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/furshield/bootstrap-compat-fix.css" asp-append-version="true" />
    <!-- FurShield brand theme for the Shelter portal only -->
    <link rel="stylesheet" href="~/css/furshield/shelter-dashboard-theme.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="dashboard-shell">
        <!-- Sidebar -->
        <aside class="dashboard-sidebar sidebar--shelter" id="shelterSidebar">
            <div class="sidebar-brand">
                <a asp-controller="Shelter" asp-action="Index">
                    <i class="bi bi-house-heart-fill"></i> Shelter Portal
                </a>
            </div>

            <div class="sidebar-back">
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-arrow-left-circle"></i> Back to Main Website
                </a>
            </div>

            @{
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                Func<string, string, string> navActive = (ctrl, action) =>
                    (string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) &&
                     string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

                var shelterUserId = UserManager.GetUserId(User);
                var unreadShelterCount = shelterUserId != null
                    ? await DbContext.Notifications.CountAsync(n => n.UserId == shelterUserId && !n.IsRead)
                    : 0;
            }
            <nav class="sidebar-nav">
                <a class="sidebar-link @navActive("Shelter", "Index")" asp-controller="Shelter" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="sidebar-link @navActive("Adoption", "Index")" asp-controller="Adoption" asp-action="Index">
                    <i class="bi bi-card-checklist"></i> Adoption Listings
                </a>
                <a class="sidebar-link @navActive("Adoption", "Interests")" asp-controller="Adoption" asp-action="Interests">
                    <i class="bi bi-people"></i> Adoption Requests
                </a>
                <a class="sidebar-link @navActive("ShelterProduct", "Index")" asp-controller="ShelterProduct" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Products
                </a>
                <a class="sidebar-link @navActive("ShelterHealthRecord", "Index")" asp-controller="ShelterHealthRecord" asp-action="Index">
                    <i class="bi bi-heart-pulse"></i> Health Records
                </a>
                <a class="sidebar-link @navActive("Notification", "Index")" asp-controller="Notification" asp-action="Index">
                    <i class="bi bi-bell-fill"></i> Notifications
                    @if (unreadShelterCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill ms-auto px-2 py-1">@unreadShelterCount</span>
                    }
                </a>
                <a class="sidebar-link @navActive("Shelter", "Profile")" asp-controller="Shelter" asp-action="Profile">
                    <i class="bi bi-building"></i> Profile
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <span class="sidebar-user-avatar"><i class="bi bi-shield-lock"></i></span>
                    @{
                        var currentUser = await UserManager.GetUserAsync(User);
                        var displayName = currentUser?.FullName ?? UserManager.GetUserName(User);
                    }

                    <span class="sidebar-user-name">@displayName</span>
                </div>
                <form class="sidebar-logout-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")">
                    <button type="submit">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </aside>

        <div class="sidebar-backdrop" id="shelterSidebarBackdrop"></div>

        <!-- Main content -->
        <div class="dashboard-content">
            <div class="dashboard-topbar">
                <button class="sidebar-toggle-btn" type="button" id="shelterSidebarToggle" aria-label="Toggle menu">
                    <i class="bi bi-list"></i>
                </button>
                <span class="fw-bold text-success"><i class="bi bi-house-heart-fill me-1"></i> Shelter Portal</span>
                <span></span>
            </div>

            <main role="main" class="dashboard-main">
                @{
                    var topbarUser = await UserManager.GetUserAsync(User);
                    var topbarName = topbarUser?.FullName ?? UserManager.GetUserName(User);
                }
                <div class="shelter-welcome">
                    <div>
                        <h2 class="mb-0 fw-bold" style="color:var(--shl-ink);">Welcome back, @topbarName</h2>
                        <p class="mb-0 text-muted">@ViewData["Title"]</p>
                    </div>
                    <span class="vet-date-pill"><i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
                </div>
                @RenderBody()
            </main>

            <footer class="dashboard-footer">
                &copy; 2026 - <strong>FurShield (Shelter Panel)</strong>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var sidebar = document.getElementById('shelterSidebar');
            var backdrop = document.getElementById('shelterSidebarBackdrop');
            var toggleBtn = document.getElementById('shelterSidebarToggle');

            function closeSidebar() {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
            }

            toggleBtn?.addEventListener('click', function () {
                sidebar.classList.toggle('show');
                backdrop.classList.toggle('show');
            });
            backdrop?.addEventListener('click', closeSidebar);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
