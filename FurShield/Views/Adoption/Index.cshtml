@model IEnumerable<FurShield.Data.AdoptionListing>

@{
    ViewData["Title"] = "Adoption Listings";
    Layout = "~/Views/Shared/_ShelterLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-card-list text-success me-2"></i>Manage Adoption Listings</h3>
        <a asp-action="Create" class="btn btn-success fw-bold"><i class="bi bi-plus-lg me-1"></i> Add New Pet</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Pet Name</th>
                            <th>Species / Breed</th>
                            <th>Age / Gender</th>
                            <th>Health Status</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No pets listed for adoption yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/45" : item.ImageUrl)"
                                                 class="rounded-circle me-3" style="width: 45px; height: 45px; object-fit: cover;" />
                                            <div>
                                                <strong class="d-block">@item.PetName</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.Species @(string.IsNullOrEmpty(item.Breed) ? "" : $"({item.Breed})")</td>
                                    <td>@item.Age yrs / @(item.Gender ?? "N/A")</td>
                                    <td><span class="badge bg-info text-dark">@(item.HealthStatus ?? "Healthy")</span></td>
                                    <td>
                                        @if (item.Status == "Available")
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Adopted</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Edit" asp-route-id="@item.AdoptionListingId" class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i> Edit</a>
                                        <form asp-action="Delete" asp-route-id="@item.AdoptionListingId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this pet?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>