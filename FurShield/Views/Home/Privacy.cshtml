@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container my-5">
    <h1 class="fw-bold text-primary mb-4">Privacy Policy</h1>
    <p class="text-muted">
        FurShield collects only the information needed to provide pet care
        management services — such as owner, pet, veterinarian, and shelter
        details you provide during registration and use of the platform. This
        information is used solely to operate the application (managing pet
        profiles, health records, appointments, and adoption listings) and is
        not sold or shared with third parties for advertising purposes.
    </p>
    <p class="text-muted">
        This is a student project built for the Aptech TechWiz 6 competition
        and is not intended for handling real production data.
    </p>
</div>
