@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="auth shadow-sm" style="width: min(480px, 100%);">
        <div class="eyebrow">Welcome Back</div>
        <h1 class="fw-bold mb-1" style="font-family:'Baloo 2',sans-serif;font-size:36px;">Sign in to FurShield</h1>
        <p class="text-muted small mb-4">Manage your pet profiles, health records, orders and adoption requests.</p>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-success rounded-3 mb-3" role="alert">@Model.StatusMessage</div>
        }

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3 small" role="alert"></div>

            <div class="field mb-3">
                <label class="fw-bold small mb-1">Email Address</label>
                <input asp-for="Input.Email" class="form-control py-3" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="field mb-3">
                <label class="fw-bold small mb-1">Password</label>
                <input asp-for="Input.Password" class="form-control py-3" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeCheck" />
                    <label class="form-check-label text-secondary small" for="rememberMeCheck">
                        Remember me
                    </label>
                </div>
                <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small text-muted">Forgot password?</a>
            </div>

            <button id="login-submit" type="submit" class="btn btn-primary btn-lg w-100 py-3 mb-3 shadow-sm">
                <i class="fa-solid fa-right-to-bracket me-2"></i> Log In
            </button>

            <div class="text-center pt-2 border-top">
                <p class="text-muted small mb-0">
                    Don't have an account yet?
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold" style="color:var(--fs-pink-dark);text-decoration:none;">
                        Create an account &rarr;
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}